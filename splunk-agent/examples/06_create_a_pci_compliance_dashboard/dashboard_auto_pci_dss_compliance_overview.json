{
  "title": "PCI DSS Compliance Overview",
  "description": "Requirement-mapped evidence for PCI DSS 1, 2, 5, 8 and 10.",
  "inputs": {
    "input_global_trp": {
      "type": "input.timerange",
      "title": "Time Range",
      "options": {
        "token": "global_time",
        "defaultValue": "-24h@h,now"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$global_time.earliest$",
            "latest": "$global_time.latest$"
          }
        }
      }
    }
  },
  "visualizations": {
    "viz_failed_access_attempts_10_2_4": {
      "type": "splunk.singlevalue",
      "title": "Failed Access Attempts (10.2.4)",
      "description": "Failed access attempts to in-scope systems.",
      "dataSources": {
        "primary": "ds_failed_access_attempts_10_2_4"
      },
      "options": {
        "majorValueSize": 36,
        "trendDisplay": "off",
        "sparklineDisplay": "off"
      },
      "eventHandlers": [
        {
          "type": "drilldown.linkToSearch",
          "options": {
            "type": "auto",
            "newTab": true
          }
        }
      ]
    },
    "viz_audit_log_changes_10_2_6": {
