  "dataSources": {
    "ds_failed_access_attempts_10_2_4": {
      "type": "ds.search",
      "name": "Failed Access Attempts (10.2.4)",
      "options": {
        "query": "((index=auth sourcetype=linux_secure) OR (index=wineventlog sourcetype=\"WinEventLog:Security\")) action IN (\"failure\", \"failed\", \"fail\")\n| stats count AS failures",
        "enableSmartSources": true
      }
    },
    "ds_audit_log_changes_10_2_6": {
      "type": "ds.search",
      "name": "Audit Log Changes (10.2.6)",
      "options": {
        "query": "index=wineventlog sourcetype=\"WinEventLog:Security\" EventCode IN (1102, 104, 4719, 4906, 4907)\n| stats count AS audit_changes",
        "enableSmartSources": true
      }
    },
    "ds_account_changes_8_2": {
      "type": "ds.search",
      "name": "Account Changes (8.2)",
      "options": {
        "query": "index=wineventlog sourcetype=\"WinEventLog:Security\" EventCode IN (4720, 4722, 4724, 4725, 4726, 4738, 4740, 4767)\n| stats count AS account_changes",
        "enableSmartSources": true
      }
    },
    "ds_malware_detections_5_2": {
      "type": "ds.search",
      "name": "Malware Detections (5.2)",
      "options": {
        "query": "index=endpoint sourcetype=\"symantec:ep:risk:file\" signature=*\n| stats count AS detections",
        "enableSmartSources": true
      }
    },
    "ds_failed_access_trend": {
      "type": "ds.search",
      "name": "Failed Access Trend",
      "options": {
        "query": "((index=auth sourcetype=linux_secure) OR (index=wineventlog sourcetype=\"WinEventLog:Security\")) action IN (\"failure\", \"failed\", \"fail\")\n| timechart span=1h count AS failures",
        "enableSmartSources": true
      }
    },
    "ds_account_changes_by_event_code": {
      "type": "ds.search",
      "name": "Account Changes by Event Code",
      "options": {
        "query": "index=wineventlog sourcetype=\"WinEventLog:Security\" EventCode IN (4720, 4722, 4724, 4725, 4726, 4738, 4740, 4767)\n| stats count AS changes BY EventCode",
        "enableSmartSources": true
      }
    },
    "ds_administrative_actions_10_2_2": {
      "type": "ds.search",
      "name": "Administrative Actions (10.2.2)",
      "options": {
        "query": "index=wineventlog sourcetype=\"WinEventLog:Security\" EventCode IN (4672, 4728, 4732, 4756)\n| stats count AS events values(EventCode) AS event_codes BY user dest\n| sort - events",
        "enableSmartSources": true
      }
    },
    "ds_default_account_usage_2_2_2": {
      "type": "ds.search",
      "name": "Default Account Usage (2.2.2)",
      "options": {
        "query": "((index=auth sourcetype=linux_secure) OR (index=wineventlog sourcetype=\"WinEventLog:Security\")) action=\"success\" user IN (\"admin\", \"administrator\", \"root\", \"guest\", \"sa\", \"default\", \"test\")\n| stats count AS logins values(src) AS sources BY user dest\n| sort - logins",
        "enableSmartSources": true
      }
    },
    "ds_network_control_changes_1_2": {
      "type": "ds.search",
      "name": "Network Control Changes (1.2)",
      "options": {
        "query": "index=firewall sourcetype=\"pan:config\" (\"configuration change\" OR \"config change\" OR \"%ASA-5-111008\" OR \"%ASA-5-111010\" OR type=CONFIG)\n| stats count AS changes latest(_time) AS last_change BY host user\n| convert ctime(last_change)",
        "enableSmartSources": true
      }
    },
    "ds_audit_log_change_details": {
      "type": "ds.search",
      "name": "Audit Log Change Details",
      "options": {
        "query": "index=wineventlog sourcetype=\"WinEventLog:Security\" EventCode IN (1102, 104, 4719, 4906, 4907)\n| table _time dest user EventCode\n| sort - _time",
        "enableSmartSources": true
      }
    },
    "ds_failed_access_by_system": {
      "type": "ds.search",
      "name": "Failed Access by System",
      "options": {
        "query": "((index=auth sourcetype=linux_secure) OR (index=wineventlog sourcetype=\"WinEventLog:Security\")) action IN (\"failure\", \"failed\", \"fail\")\n| stats count AS failures dc(user) AS accounts BY dest\n| sort - failures",
        "enableSmartSources": true
      }
    }
  },
