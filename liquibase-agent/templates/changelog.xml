<!-- @template changelog -->
<?xml version="1.0" encoding="UTF-8"?>
<!--
    ${title}
    Generated by liquibase-agent (offline, rule based) on ${generated_at}
    Source(s): ${sources}
    Dialect  : ${dialect}
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-${xsd_version}.xsd">
${body}
</databaseChangeLog>
<!-- @template changelog_preconditions -->
    <preConditions onFail="HALT" onFailMessage="This changelog targets ${dbms} only">
        <dbms type="${dbms}"/>
    </preConditions>
<!-- @template property -->
    <property name="${name}" value="${value}"${extra}/>
<!-- @template changeset -->
    <changeSet id="${id}" author="${author}"${attrs}>
        <comment>${comment}</comment>
${preconditions}${changes}
        <rollback>
${rollback}
        </rollback>
    </changeSet>
<!-- @template preconditions -->
        <preConditions onFail="${on_fail}" onError="${on_error}">
${conditions}
        </preConditions>
<!-- @template tag -->
    <changeSet id="${id}" author="${author}">
        <comment>Tag database before release ${release}</comment>
        <tagDatabase tag="${tag}"/>
    </changeSet>
